# =============================================================
# KENTECHTIME Next.js 환경 변수 예시
# .env.local 파일을 만들어 아래 변수들을 채워주세요.
# 절대 GitHub에 커밋하지 마세요!
# =============================================================

# Supabase (프로젝트 Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# JWT 서명 키 (랜덤 문자열, 예: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here

# Google OAuth Client ID (Google Cloud Console → 사용자 인증 정보)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# 브라우저에서 GoogleLogin 버튼에 사용 (NEXT_PUBLIC_ 접두사 필수)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# OpenAI API 키
OPENAI_API_KEY=sk-...

# 현재 학기 (형식: YYYY-spring | YYYY-fall)
CURRENT_SEMESTER=2026-spring
