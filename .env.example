# =============================================================
# KENTECHTIME 환경 변수 예시
# 절대 GitHub에 커밋하지 마세요!
#
# 사용법:
#   1. 루트에 .env 파일 생성 후 아래 서버 변수 채우기
#   2. client/.env 파일 생성 후 아래 클라이언트 변수 채우기
# =============================================================

# ── 서버 변수 (.env 루트에 저장) ──────────────────────────────

# Supabase PostgreSQL 연결 문자열
DATABASE_URL=postgresql://user:password@localhost:5432/kentechtime

# JWT 서명 키 (랜덤 문자열, 예: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here

# OpenAI API 키
OPENAI_API_KEY=sk-...

# 서버 포트
PORT=4000

# 현재 학기 (형식: YYYY-spring | YYYY-fall)
CURRENT_SEMESTER=2026-spring

# Google OAuth Client ID (Google Cloud Console → 사용자 인증 정보에서 발급)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com


# ── 클라이언트 변수 (client/.env 에 저장) ─────────────────────
# React CRA는 client/ 디렉토리 안의 .env 파일만 읽습니다.
# client/.env 파일을 별도로 만들어서 아래 변수를 넣어주세요.

# REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# REACT_APP_API_URL=http://localhost:4000/api
